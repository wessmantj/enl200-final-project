; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but you can always change it manually here.
;
; The format is:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="The Factory"
config/description="Based on 'The Factory' by Hiroko Oyamada"
run/main_scene="res://scenes/ui/MainMenu.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameClock="*res://scripts/autoload/GameClock.gd"
DialogueManager="*res://scripts/autoload/DialogueManager.gd"
SceneTransition="*res://scripts/autoload/SceneTransition.gd"
GameState="*res://scripts/autoload/GameState.gd"
WorldTravel="*res://scripts/autoload/WorldTravel.gd"
PauseMenu="*res://scripts/autoload/PauseMenu.gd"

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[gui]

theme/custom="res://assets/ui/theme.tres"

[layer_names]

2d_render/layer_1="world"
2d_render/layer_2="player"
2d_render/render_layer_3="ui"

